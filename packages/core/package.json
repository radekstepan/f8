{
  "name": "@f8/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "echo \"(no lint configured)\" && exit 0",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
