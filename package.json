{
  "name": "f8",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "e2e": "turbo run e2e",
    "setup": "yarn workspace @f8/server setup",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.5.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
